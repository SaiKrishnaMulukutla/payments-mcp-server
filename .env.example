# PostgreSQL is mandatory. No SQLite or in-memory fallback.
DATABASE_URL=postgresql://bharat_connect:change-me@localhost:5432/bharat_connect

# Generate independent random secrets; do not commit real values.
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNT_ENCRYPTION_KEY=
# At least 32 random bytes, represented as a high-entropy string.
APPROVAL_SIGNING_SECRET=

# Cashfree partner credentials are intentionally absent until COU onboarding
# and the current partner API contract are received.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox

MAX_BILL_AMOUNT_PAISE=1000000
APPROVAL_TTL_SECONDS=300
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
